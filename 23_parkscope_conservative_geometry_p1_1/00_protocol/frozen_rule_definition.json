    "otherwise -> UNCERTAIN_NO_EVIDENCE"
  ],
  "frame_rule": "any positive; else all negative; else uncertain",
  "parameter_grid": {
    "line_elongation_min": [2.5, 3.5, 5.0],
    "line_max_thickness_ratio": [0.15, 0.25, 0.35],
    "parallel_angle_max": [15, 25, 35],
    "separator_center_margin": [0.15, 0.25, 0.35],
    "bracket_max_distance_ratio": [0.75, 1.0, 1.25],
    "area_support_min": [0.3, 0.5, 0.7]
  }
}
