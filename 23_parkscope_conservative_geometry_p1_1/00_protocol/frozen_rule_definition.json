{
  "rule_version": "PARKSCOPE_CONSERVATIVE_GEOMETRY_P1_1",
  "outside_fallback_removed": true,
  "outside_positive_enabled": false,
  "target_rule": [
    "invalid anchor -> UNCERTAIN_ANCHOR",
