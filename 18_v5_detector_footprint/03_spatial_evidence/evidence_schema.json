    "vehicle_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "coordinate_space": {
      "type": [
        "string",
        "null"
      ]
    },
    "footprint_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "road_overlap_ratio": {
